# Example for /opt/wg-panel. The managed installer writes its actual panel/bot units.
[Unit]
Description=WG_Panel Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/wg-panel
EnvironmentFile=/opt/wg-panel/.env
ExecStart=/opt/wg-panel/venv/bin/python /opt/wg-panel/telegram_bot.py
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target
